{
  "name": "not-for-you",
  "description": "Removes algorithmic and suggested content from social media sites.",
  "private": true,
  "license": "MIT",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preziotte/not-for-you.git"
  },
  "homepage": "https://notforyou.app",
  "bugs": "https://github.com/preziotte/not-for-you/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/icons.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:site": "node scripts/serve-site.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
